# Server Settings
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projecthub_dev?schema=public"

# JWT - Tokens for authentication
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP)
# For local development, run `docker-compose up -d mailpit` and use:
# - SMTP_HOST=localhost
# - SMTP_PORT=1025
# - Mailpit UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@projecthub.local
# SMTP_USER=
# SMTP_PASS=

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

