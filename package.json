{
  "scripts": {
    "dev-backend": "npm run dev --prefix backend",
    "dev-frontend": "npm run dev --prefix frontend/web",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix \"[{name}]\" --prefix-colors \"blue.bold,green.bold\" --timestamp-format \"HH:mm:ss\" \"npm run dev-backend\" \"npm run dev-frontend\"",
    "build-backend": "npm run build --prefix backend",
    "build-frontend": "npm run build --prefix frontend/web",
    "build": "concurrently --names \"BUILD-BACKEND,BUILD-FRONTEND\" --prefix \"[{name}]\" --prefix-colors \"magenta.bold,cyan.bold\" --timestamp-format \"HH:mm:ss\" \"npm run build-backend\" \"npm run build-frontend\""
  },
  "devDependencies": {
    "tsconfig-paths": "^4.2.0",
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
